# Blank form. Copy to .env.local and fill your own values.
# .env.local is gitignored. Do not put secrets in this file.

# Public site origin (used for metadata / canonical URLs)
NEXT_PUBLIC_SITE_URL=https://example.com

# Optional subpath deploy (e.g. GitHub Pages project site)
# NEXT_PUBLIC_BASE_PATH=

# Content gating: local | preprod | global
# Unset: next dev → local; next build → global (published/canonical only)
# NEXT_PUBLIC_CONTENT_TIER=local

# Pinata (optional IPFS pin after `npm run build`)
# PINATA_JWT=
# PINATA_GATEWAY=https://YOUR-SUBDOMAIN.mypinata.cloud
# PINATA_IPNS_NAME=
# NEXT_PUBLIC_IPFS_CID=
# NEXT_PUBLIC_IPFS_GATEWAY=
