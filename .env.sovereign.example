# Optional sovereign / IPFS deploy — copy keys you need into .env.local
# Never commit .env.local or real JWTs.

# --- Local Kubo (optional) ---
# IPFS_API=/ip4/127.0.0.1/tcp/5001
# IPFS_GATEWAY=http://127.0.0.1:8080
# IPNS_KEY_NAME=self
# IPFS_BIN=

# --- Pinata (optional public pin) ---
# PINATA_JWT=
# PINATA_GATEWAY=https://YOUR-SUBDOMAIN.mypinata.cloud
# PINATA_IPNS_NAME=
# PINATA_PIN_NAME=tannery-out

# Bake into the next build after a successful pin:
# NEXT_PUBLIC_IPFS_CID=
# NEXT_PUBLIC_IPFS_GATEWAY=http://127.0.0.1:8080
# NEXT_PUBLIC_IPNS_NAME=
